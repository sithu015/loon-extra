#!name = Myanmar Essential
#!desc = Myanmar Banking, Telecom, Government & Local Services (DIRECT), Blocked Independent Media (PROXY), and Ad/Tracker Blocking (REJECT) for Loon 3.5.1+
#!author = sithu015
#!homepage = https://github.com/sithu015/loon-extra
#!icon = https://raw.githubusercontent.com/sithu015/loon-extra/main/icon.png
#!source = 2816d0e79e4efc889eb6bb7370a73e174e9295c59eba5c0300cd81e9e2c01194, a54424d3f1dd018fe5e1ede23dbf87ec9adc835837c3d36303bbd4d4de4a9bd9
#!system = iOS,iPadOS,macOS
#!system_version = 15.0
#!loon_version = 3.5.1(983)
#!date = 2026-11-26
#!tag = Myanmar,Routing,AdBlock
#!type = normal

[Argument]
blockMetaPixel = switch,false,type=boolean,tag=Block Meta Pixel (MitM),desc=Requires MitM on facebook.com (install meta-pixel-mitm.lpx or add www.facebook.com to [MITM]); keep off unless needed

[Rule]
# ==============================================================================
# 1. Apple Services & CDN Fallback Fixes (Log-Observed)
# ==============================================================================
DOMAIN,c.apple.news,DIRECT
DOMAIN,cdn.apple-mapkit.com,DIRECT
DOMAIN-SUFFIX,cdn-apple.com,DIRECT
DOMAIN-SUFFIX,edge.apple,DIRECT
DOMAIN-SUFFIX,safebrowsing.apple,DIRECT
IP-CIDR,17.0.0.0/8,DIRECT,no-resolve
IP-CIDR6,2620:149::/32,DIRECT,no-resolve

# ==============================================================================
# 2. Myanmar Banks & Mobile Payment Apps (DIRECT — Geo-Block & Pinning Safe)
# ==============================================================================
DOMAIN-SUFFIX,kbzbank.com,DIRECT
DOMAIN-SUFFIX,kbzpay.com,DIRECT
DOMAIN-SUFFIX,wavemoney.com.mm,DIRECT
DOMAIN-SUFFIX,ayabank.com,DIRECT
DOMAIN-SUFFIX,ayaibanking.com,DIRECT
DOMAIN-SUFFIX,ayacib.com,DIRECT
DOMAIN-SUFFIX,ayapay.com,DIRECT
DOMAIN-SUFFIX,cbbank.com.mm,DIRECT
DOMAIN-SUFFIX,uab.com.mm,DIRECT
DOMAIN-SUFFIX,uabpay.com.mm,DIRECT
DOMAIN-SUFFIX,yomabank.com,DIRECT
DOMAIN-SUFFIX,mabbank.com,DIRECT
DOMAIN-SUFFIX,abank.com.mm,DIRECT
DOMAIN-SUFFIX,agdbank.com.mm,DIRECT
DOMAIN-SUFFIX,myanmarpaymentunion.com,DIRECT
DOMAIN-SUFFIX,mpu-ecommerce.com,DIRECT
DOMAIN-SUFFIX,onepay.com.mm,DIRECT
DOMAIN-SUFFIX,mcb.com.mm,DIRECT
DOMAIN-SUFFIX,okdollar.com,DIRECT
DOMAIN-SUFFIX,truemoney.com.mm,DIRECT
DOMAIN-SUFFIX,momopaymm.com,DIRECT

# ==============================================================================
# 3. Myanmar Telecoms & ISPs (DIRECT)
# ==============================================================================
DOMAIN-SUFFIX,mpt.com.mm,DIRECT
DOMAIN-SUFFIX,atom.com.mm,DIRECT
DOMAIN-SUFFIX,telenor.com.mm,DIRECT
DOMAIN-SUFFIX,u9.com.mm,DIRECT
DOMAIN-SUFFIX,ooredoo.com.mm,DIRECT
DOMAIN-SUFFIX,mytel.com.mm,DIRECT
DOMAIN-SUFFIX,myanmarnet.com,DIRECT
DOMAIN-SUFFIX,5bb.com.mm,DIRECT
DOMAIN-SUFFIX,welinkbroadband.com,DIRECT
DOMAIN-SUFFIX,maharnet.com,DIRECT

# ==============================================================================
# 4. Myanmar Government, Education & Utilities (DIRECT)
# ==============================================================================
DOMAIN-SUFFIX,gov.mm,DIRECT
DOMAIN-SUFFIX,edu.mm,DIRECT
DOMAIN-SUFFIX,com.mm,DIRECT
DOMAIN-SUFFIX,org.mm,DIRECT
DOMAIN-SUFFIX,net.mm,DIRECT
DOMAIN-SUFFIX,yesc.com.mm,DIRECT
DOMAIN-SUFFIX,mescmm.com,DIRECT
DOMAIN-SUFFIX,ysx-mm.com,DIRECT

# ==============================================================================
# 5. Myanmar E-Commerce, Delivery, Real Estate, Jobs & Domestic Media (DIRECT)
# ==============================================================================
DOMAIN-SUFFIX,shop.com.mm,DIRECT
DOMAIN-SUFFIX,citymall.com.mm,DIRECT
DOMAIN-SUFFIX,citymallcentersmm.com,DIRECT
DOMAIN-SUFFIX,foodpanda.com.mm,DIRECT
DOMAIN-SUFFIX,grab.com,DIRECT
DOMAIN-SUFFIX,imyanmarhouse.com,DIRECT
DOMAIN-SUFFIX,shweproperty.com,DIRECT
DOMAIN-SUFFIX,carsdb.com,DIRECT
DOMAIN-SUFFIX,imyanmarmarket.com,DIRECT
DOMAIN-SUFFIX,jobnet.com.mm,DIRECT
DOMAIN-SUFFIX,myjobs.com.mm,DIRECT
DOMAIN-SUFFIX,yangondirectory.com,DIRECT
DOMAIN-SUFFIX,elevenmyanmar.com,DIRECT
DOMAIN-SUFFIX,popularmyanmar.com,DIRECT
DOMAIN-SUFFIX,duwun.com.mm,DIRECT
DOMAIN-SUFFIX,thutazone.net,DIRECT
DOMAIN-SUFFIX,gnlm.com.mm,DIRECT

# ==============================================================================
# 6. Independent & International Burmese Media (PROXY — Blocked inside Myanmar)
# ==============================================================================
DOMAIN-SUFFIX,irrawaddy.com,PROXY
DOMAIN-SUFFIX,dvb.no,PROXY
