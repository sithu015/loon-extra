# ==============================================================================
# 7. Additional Ad Networks & Trackers (REJECT — Complements FinalV1.lcf)
# ==============================================================================
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,mgid.com,REJECT
DOMAIN-SUFFIX,taboola.com,REJECT
DOMAIN-SUFFIX,outbrain.com,REJECT
DOMAIN-SUFFIX,revcontent.com,REJECT
DOMAIN-SUFFIX,media.net,REJECT
DOMAIN-SUFFIX,highperformanceformat.com,REJECT
DOMAIN-SUFFIX,popads.net,REJECT
DOMAIN-SUFFIX,propellerads.com,REJECT
DOMAIN-SUFFIX,connect.facebook.net,REJECT
DOMAIN-SUFFIX,analytics.tiktok.com,REJECT
DOMAIN-SUFFIX,clarity.ms,REJECT
DOMAIN-SUFFIX,bat.bing.com,REJECT
DOMAIN-SUFFIX,appsflyersdk.com,REJECT
DOMAIN-SUFFIX,singular.net,REJECT
DOMAIN-SUFFIX,servedbyadbutler.com,REJECT
DOMAIN-SUFFIX,analytics.ahrefs.com,REJECT
DOMAIN-SUFFIX,static.cloudflareinsights.com,REJECT

[Rewrite]
# Optional Loon 3.5.1+ Rewrite v2 rule for Meta Pixel tracking endpoint
request if ${blockMetaPixel} == true && ${url} ~= /^https?:\/\/(www\.)?facebook\.com\/tr/ then reject_img(200)
