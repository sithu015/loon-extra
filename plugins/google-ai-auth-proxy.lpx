#!name = Google AI & Auth Routing
#!desc = Routes log-observed Google Auth/Capability endpoints and AI services (Antigravity, Gemini) through a selectable PROXY group (e.g., US Auto) for Loon 3.5.1+
#!author = sithu015
#!homepage = https://github.com/sithu015/loon-extra
#!icon = https://raw.githubusercontent.com/sithu015/loon-extra/main/assets/icons/google-ai-auth-proxy.png
#!source = 4df587ff9d7493b735f0776e6a1f756ce63b10c0121361b65c3309308fd1ea50, 19eceb8771ecd070e17c63509296f92b805147383e1a803af60a61b8560c54c1
#!system = iOS,iPadOS,macOS
#!system_version = 15.0
#!loon_version = 3.5.1(983)
#!date = 2026-11-26
#!tag = AI,Google,Routing
#!type = normal

[Rule]
# ==============================================================================
# 1. Google Account Auth & Region Capability Checks (Log-Observed -> US/Proxy)
# ==============================================================================
DOMAIN,securitydomain-pa.googleapis.com,PROXY
DOMAIN,reach-pa.googleapis.com,PROXY
DOMAIN,accountcapabilities-pa.googleapis.com,PROXY
DOMAIN,aida.googleapis.com,PROXY
DOMAIN,aisandbox-pa.googleapis.com,PROXY
DOMAIN,robinfrontend-pa.googleapis.com,PROXY
DOMAIN-SUFFIX,geller-pa.googleapis.com,PROXY
DOMAIN-SUFFIX,proactivebackend-pa.googleapis.com,PROXY
DOMAIN,jetski-webchannel.googleapis.com,PROXY
DOMAIN,oauthaccountmanager.googleapis.com,PROXY
DOMAIN,optimizationguide-pa.googleapis.com,PROXY
DOMAIN,b1.nel.goog,PROXY
DOMAIN,csp.withgoogle.com,PROXY

# ==============================================================================
# 2. Google Gemini & Antigravity Endpoints
# ==============================================================================
DOMAIN-SUFFIX,gemini.google.com,PROXY
DOMAIN-SUFFIX,gemini.google,PROXY
DOMAIN-SUFFIX,bard.google.com,PROXY
DOMAIN-SUFFIX,generativelanguage.googleapis.com,PROXY
DOMAIN-SUFFIX,aistudio.google.com,PROXY
DOMAIN-SUFFIX,makersuite.google.com,PROXY
DOMAIN,ai.google.dev,PROXY
DOMAIN-SUFFIX,generativeai.google,PROXY
DOMAIN-SUFFIX,deepmind.google,PROXY
DOMAIN-SUFFIX,notebooklm.google,PROXY
DOMAIN-SUFFIX,notebooklm.google.com,PROXY
DOMAIN,jules.google.com,PROXY
DOMAIN,stitch.withgoogle.com,PROXY
DOMAIN-SUFFIX,cloudaicompanion.googleapis.com,PROXY
DOMAIN-SUFFIX,antigravity.google,PROXY
DOMAIN-SUFFIX,antigravity.google.com,PROXY
DOMAIN,antigravity-unleash.goog,PROXY
DOMAIN,aicode.googleapis.com,PROXY
DOMAIN-SUFFIX,cloudcode-pa.googleapis.com,PROXY
DOMAIN-SUFFIX,daily-cloudcode-pa.googleapis.com,PROXY
DOMAIN,antigravity-cli-auto-updater-974169037036.us-central1.run.app,PROXY
DOMAIN,antigravity-hub-auto-updater-974169037036.us-central1.run.app,PROXY
